# Copy to .env next to grep2jev.ts, or to ~/.jev_key (needed when an agent runs the CLIs inside its sandbox).
# Precedence: shell environment, then .env, then ~/.jev_key. TypeSafe wins if both keys are set.
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=
# JEV_BACKEND=mock   # offline word-overlap mock: checks wiring, not judgment
